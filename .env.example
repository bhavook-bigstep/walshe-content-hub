# Walsh Content Hub — environment template.
# Copy to .env and fill in locally. NAMES ONLY here: never commit real values (Contract 2).

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/content_hub

# --- Auth ---
JWT_SECRET=
TOKEN_TTL_SECONDS=28800

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=content-hub

# --- AI provider selection: claude | openai | gemini ---
# With no matching key set, the API uses a deterministic stub (demo still runs).
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
