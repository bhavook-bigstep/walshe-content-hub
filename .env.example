# Walsh Content Hub — environment template.
# Copy to .env and fill in locally. NAMES ONLY here: never commit real values (Contract 2).

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/content_hub

# --- Auth ---
JWT_SECRET=
TOKEN_TTL_SECONDS=28800

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=content-hub

# --- AI provider selection: claude | openai | gemini ---
# With no matching key set, the API uses a deterministic stub (demo still runs).
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Instagram publishing (Graph API with Instagram Login) ---
# With no token/user id set, publishing falls back to a deterministic stub connector.
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v26.0

# --- S3 media hosting (presigned GET URL so Instagram can fetch the image) ---
# Works with AWS S3 or any S3-compatible store. For Supabase Storage set S3_ENDPOINT_URL to
# https://<project-ref>.storage.supabase.co/storage/v1/s3 and use its S3 access key/secret/region.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PRESIGN_TTL=3600
